# Cấu hình Telegram Bot cho ESP32-CAM Mask Detection
# Lưu ý: Sao chép file này thành .env và điền thông tin của bạn. Không commit file .env lên Git.

# Token của Telegram Bot do @BotFather cung cấp (ví dụ: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=

# Chat ID được phép gửi lệnh (phân tách bởi dấu phẩy nếu có nhiều ID, ví dụ: 123456789,987654321)
# Để trống nếu muốn cho phép mọi chat ID (không khuyến nghị)
TELEGRAM_ALLOWED_CHAT_IDS=

# Địa chỉ IP của ESP32-CAM (mặc định: 192.168.1.153)
ESP32_IP=192.168.1.153

# Thời gian tối đa (giây) coi dữ liệu YOLO là còn mới (mặc định: 5.0)
TELEGRAM_STALE_THRESHOLD=5.0

# Chế độ suy luận: local (GPU RTX 5060) hoặc cloud (AWS EC2)
INFERENCE_MODE=local

# URL của Cloud Inference API (qua SSH tunnel hoặc HTTPS)
CLOUD_API_URL=http://127.0.0.1:9000/v1/infer
CLOUD_SOCKET_TIMEOUT=4.0
