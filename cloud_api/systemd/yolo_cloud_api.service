[Unit]
Description=YOLO11n Cloud Mask Detection FastAPI Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/mask_detection
Environment="PATH=/opt/mask_detection/venv/bin:/usr/local/bin:/usr/bin"
Environment="CLOUD_MODEL_PATH=/opt/mask_detection/weights/best.pt"
Environment="CLOUD_INFERENCE_DEVICE=cpu"
Environment="CLOUD_API_PORT=8000"
Environment="CLOUD_API_HOST=127.0.0.1"
EnvironmentFile=-/opt/mask_detection/.env
ExecStart=/opt/mask_detection/venv/bin/uvicorn cloud_api.main:app --host 127.0.0.1 --port 8000 --workers 1 --log-level info
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
